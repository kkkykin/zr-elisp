(ert-deftest zr-shadowfile-state-write-failure-keeps-old-state-and-retries-on-save ()
  (zr-shadowfile-test--with-state
    (let* ((source (expand-file-name "org/"))
           (first (expand-file-name "first.org" source))
           (second (expand-file-name "second.org" source))
           (rename (symbol-function 'rename-file)))
      (setq zr-shadowfile-rules
            (list (zr-shadowfile-test--rule source (expand-file-name "copies/"))))
      (zr-shadowfile-test--write first "First")
      (with-current-buffer (find-file-noselect first)
        (goto-char (point-max)) (insert "\nSaved") (save-buffer))
      (zr-shadowfile-test--write second "Second")
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (old new &optional overwrite)
                   (if (equal new zr-shadowfile--state-file)
                       (signal 'file-error '("Cannot replace pending state"))
                     (funcall rename old new overwrite)))))
        (with-current-buffer (find-file-noselect second)
