        (with-current-buffer (find-file-noselect file)
          (erase-buffer) (insert "UNSAVED BUFFER CONTENT"))
        (pcase change
          ('exclude (setf (plist-get (car zr-shadowfile-rules) :exclude) "\\`notes\\.org\\'"))
