(ert-deftest zr-shadowfile-successful-saves-queue-and-exit-setting-controls-copying ()
  (zr-shadowfile-test--with-state
    (let* ((source (expand-file-name "org/"))
           (destination (expand-file-name "copies/"))
           (file (expand-file-name "new/中文 notes.org" source))
           (target (expand-file-name "new/中文 notes.org" destination)))
      (setq zr-shadowfile-rules (list (zr-shadowfile-test--rule source destination)))
      (make-directory (file-name-directory file) t)
      (with-current-buffer (find-file-noselect file)
        (setq buffer-file-coding-system 'utf-8-dos)
        (insert "第一行\nsecond\n") (save-buffer))
      (should (gethash (cons file target) zr-shadowfile--pending))
      (should (member (cons file target) (zr-shadowfile-test--state)))
      (let ((zr-shadowfile-copy-on-exit nil)) (should (zr-shadowfile--query-exit)))
      (should (= (hash-table-count zr-shadowfile--pending) 1))
      (should (zr-shadowfile--query-exit))
      (should (= (hash-table-count zr-shadowfile--pending) 0))
      (should (equal (zr-shadowfile-test--bytes file) (zr-shadowfile-test--bytes target)))
      (should (string-match-p "\r\n" (zr-shadowfile-test--bytes target))))))

(ert-deftest zr-shadowfile-failed-save-does-not-queue-a-copy ()
