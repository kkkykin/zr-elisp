(ert-deftest zr-shadowfile-overlapping-rules-do-not-prune-an-included-directory ()
  (zr-shadowfile-test--with-state
    (let* ((source (expand-file-name "org/"))
           (first (expand-file-name "copies/"))
           (second (expand-file-name "other-copies/"))
           (restricted (list :source source :destination first :exclude "\\`private\\'")))
