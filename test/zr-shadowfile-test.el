(ert-deftest zr-shadowfile-saving-updates-an-existing-task-to-the-current-rule-policy ()
  (zr-shadowfile-test--with-state
    (let ((file (expand-file-name "notes.txt"))
          (target "/webdav:example.invalid:/dav/notes.txt")
          (sync-calls 0) (async-calls 0))
      (setq zr-shadowfile-rules (list (list :source file :destination target :async nil)))
      (zr-shadowfile-test--write file "Initial")
      (let ((buffer (find-file-noselect file)))
        (zr-shadowfile-test--with-clock
          (cl-letf (((symbol-function 'zr-shadowfile--copy-file)
                     (lambda (_pair) (cl-incf sync-calls)))
                    ((symbol-function 'zr-tramp-webdav-copy-file-async)
                     (lambda (_file _target callback)
                       (cl-incf async-calls) (funcall callback t nil) #'ignore)))
            (zr-shadowfile-test--save buffer "Manual")
            (should-not events)
            (setf (plist-get (car zr-shadowfile-rules) :async) 10)
            (zr-shadowfile-test--save buffer "Delayed")
            (let ((first (car events)))
              (should (= (plist-get first :delay) 10))
              (setq now 1005.0)
              (setf (plist-get (car zr-shadowfile-rules) :async) 20)
              (zr-shadowfile-test--save buffer "Longer delay")
              (let ((second (car events)))
                (should (= (plist-get second :delay) 20))
                (setf (plist-get (car zr-shadowfile-rules) :async) nil)
                (zr-shadowfile-test--save buffer "Manual again")
                (setq now 1030.0)
                (zr-shadowfile-test--fire first)
                (zr-shadowfile-test--fire second)
                (should (zerop async-calls))
                (should (equal (car (zr-shadowfile-test--records)) (list file target nil nil)))
                (let ((batch (zr-shadowfile-copy-files t)))
                  (should (zr-shadowfile--batch-done batch)))
                (should (= sync-calls 1))
                (should-not (zr-shadowfile-test--state))))))))))

(ert-deftest zr-shadowfile-disabling-automatic-copy-during-upload-keeps-the-new-version-pending ()
  (dolist (policy '(nil t))
    (zr-shadowfile-test--with-state
      (let ((file (expand-file-name "notes.txt"))
            (target "/webdav:example.invalid:/dav/notes.txt")
            (sync-calls 0) (async-calls 0) callback finish)
        (setq zr-shadowfile-rules (list (list :source file :destination target :async 10)))
        (zr-shadowfile-test--write file "Initial")
        (let ((buffer (find-file-noselect file)))
          (zr-shadowfile-test--with-clock
            (cl-letf (((symbol-function 'zr-shadowfile--copy-file)
                       (lambda (_pair) (cl-incf sync-calls)))
                      ((symbol-function 'zr-tramp-webdav-copy-file-async)
                       (lambda (_file _target completed)
                         (cl-incf async-calls)
                         (if finish (funcall completed t nil) (setq callback completed))
                         #'ignore)))
              (zr-shadowfile-test--save buffer "First")
              (setq now 1010.0)
              (zr-shadowfile-test--fire (car events))
              (should (= async-calls 1))
              (setf (plist-get (car zr-shadowfile-rules) :async) policy)
              (zr-shadowfile-test--save buffer "Second")
              (funcall callback t nil)
              (zr-shadowfile-test--fire (car events))
              (should-not zr-shadowfile--batch)
              (should (= async-calls 1))
              (should (zerop sync-calls))
              (should (equal (car (zr-shadowfile-test--records)) (list file target policy nil)))
              (setq finish t)
              (let ((batch (zr-shadowfile-copy-files t)))
                (should (zr-shadowfile--batch-done batch)))
              (should (= async-calls (if policy 2 1)))
              (should (= sync-calls (if policy 0 1)))
              (should-not (zr-shadowfile-test--state)))))))))

(ert-deftest zr-shadowfile-disabling-an-automatic-task-removes-it-from-a-busy-batch ()
  (zr-shadowfile-test--with-state
    (let* ((first (expand-file-name "first.txt"))
           (second (expand-file-name "second.txt"))
           (target "/webdav:example.invalid:/dav/")
           (sync-calls 0) (async-calls 0) callback)
      (setq zr-shadowfile-rules
            (list (list :source first :destination (concat target "first.txt") :async 0)
                  (list :source second :destination (concat target "second.txt") :async 5)))
      (dolist (file (list first second)) (zr-shadowfile-test--write file "Initial"))
      (let ((first-buffer (find-file-noselect first))
            (second-buffer (find-file-noselect second)))
        (zr-shadowfile-test--with-clock
          (cl-letf (((symbol-function 'zr-shadowfile--copy-file)
                     (lambda (_pair) (cl-incf sync-calls)))
                    ((symbol-function 'zr-tramp-webdav-copy-file-async)
                     (lambda (_file _target completed)
                       (cl-incf async-calls) (setq callback completed) #'ignore)))
            (zr-shadowfile-test--save first-buffer "First")
            (zr-shadowfile-test--fire (car events))
            (zr-shadowfile-test--save second-buffer "Second")
            (setq now 1005.0)
            (zr-shadowfile-test--fire (car events))
            (should (= async-calls 1))
            (setf (plist-get (nth 1 zr-shadowfile-rules) :async) nil)
            (zr-shadowfile-test--save second-buffer "Second is now manual")
            (funcall callback t nil)
            (zr-shadowfile-test--fire (car events))
            (should-not zr-shadowfile--batch)
            (should (= async-calls 1))
            (should (zerop sync-calls))
            (should (equal (car (zr-shadowfile-test--records))
                           (list second (concat target "second.txt") nil nil)))
            (let ((batch (zr-shadowfile-copy-files t)))
              (should (zr-shadowfile--batch-done batch)))
            (should (= sync-calls 1))
            (should-not (zr-shadowfile-test--state))))))))

