;;; zr-shadowfile-test.el --- Tests for file and directory copies -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'zr-shadowfile)
(require 'zr-test-helpers)
(require 'zr-tramp-webdav)

(defconst zr-shadowfile-test--server-file
  (expand-file-name "webdav-server.py"
                    (file-name-directory (or load-file-name buffer-file-name))))

(defmacro zr-shadowfile-test--with-state (&rest body)
  "Run BODY with isolated copy rules, hooks, state and temporary files."
  (declare (indent 0) (debug t))
  `(zr-test-with-temp-directory
     (let* ((zr-shadowfile-rules nil)
            (zr-shadowfile-pending-file (expand-file-name "pending.eld"))
            (zr-shadowfile--pending (make-hash-table :test #'equal))
            (zr-shadowfile--pending-dirty nil)
            (zr-shadowfile--state-file nil)
            (zr-shadowfile--active nil)
            (zr-shadowfile-mode nil)
            (zr-shadowfile-noquery t)
            (zr-shadowfile-copy-on-exit t)
            (after-save-hook nil)
            (kill-emacs-query-functions nil)
            (create-lockfiles nil)
            (backup-inhibited t))
       (unwind-protect
           (progn (zr-shadowfile-mode 1) ,@body)
         (zr-shadowfile-mode -1)))))

(defmacro zr-shadowfile-test--with-webdav (&rest body)
  "Run BODY against a real local WebDAV server, binding `remote-root'."
  (declare (indent 0) (debug t))
  `(progn
     (skip-unless (and (executable-find "python3") (executable-find "curl")))
     (let* ((server-buffer (generate-new-buffer " *zr-shadowfile-server*"))
            (server (make-process
                     :name "zr-shadowfile-server" :buffer server-buffer
                     :command (list "python3" "-u" zr-shadowfile-test--server-file)
                     :connection-type 'pipe :coding 'utf-8-unix :noquery t))
            (deadline (+ (float-time) 5))
            (auth-sources nil)
            (auth-source-do-cache nil)
            (zr-http-default-options '(:proxy nil :timeout 3))
            (zr-tramp-webdav-http-options nil)
            (zr-tramp-webdav--passwords (make-hash-table :test #'equal))
            (zr-tramp-webdav--connected (make-hash-table :test #'equal))
            (tramp-cache-data (make-hash-table :test #'equal))
            (tramp-verbose 0)
            port remote-root)
       (unwind-protect
           (progn
             (while (and (not port) (process-live-p server) (< (float-time) deadline))
               (accept-process-output server 0.05)
               (with-current-buffer server-buffer
                 (goto-char (point-min))
                 (when (re-search-forward "PORT \\([0-9]+\\)" nil t)
                   (setq port (match-string 1)))))
             (unless port
               (error "WebDAV server did not start: %s"
                      (with-current-buffer server-buffer (buffer-string))))
             (setq remote-root (format "/webdav:127.0.0.1#%s:/dav/shadows/" port))
             (make-directory remote-root)
             ,@body)
         (dolist (buffer (buffer-list))
           (when (and remote-root (buffer-local-value 'buffer-file-name buffer)
                      (string-prefix-p remote-root
                                       (buffer-local-value 'buffer-file-name buffer)))
             (with-current-buffer buffer (set-buffer-modified-p nil))
             (kill-buffer buffer)))
         (when (process-live-p server) (delete-process server))
         (kill-buffer server-buffer)))))

(defun zr-shadowfile-test--bytes (file)
  "Read FILE without changing its bytes or line endings."
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally file)
    (buffer-string)))

(defun zr-shadowfile-test--state ()
  "Read pending copies from the state file as data."
  (with-temp-buffer
    (insert-file-contents zr-shadowfile-pending-file)
    (read (current-buffer))))

(defun zr-shadowfile-test--rule (source destination)
  "Build a directory rule excluding .git files and directories."
  (list :source source :destination destination
        :exclude "\\(?:\\`\\|/\\)\\.git\\(?:/\\|\\'\\)"))

(defun zr-shadowfile-test--write (file contents)
  "Write CONTENTS to FILE, creating its parent directories."
  (make-directory (file-name-directory file) t)
  (write-region contents nil file nil 'silent))

(defun zr-shadowfile-test--git (directory &rest args)
  "Run Git ARGS in DIRECTORY, reporting its output on failure."
  (let ((default-directory directory))
    (with-temp-buffer
      (let ((status (apply #'process-file "git" nil t nil
                           "-c" "user.name=zr-shadowfile tests"
                           "-c" "user.email=zr-shadowfile-tests@example.invalid"
                           "-c" "commit.gpgsign=false"
                           "-c" (concat "core.hooksPath="
                                        (expand-file-name ".git/no-hooks" directory))
                           "-c" (concat "core.excludesFile="
                                        (expand-file-name ".git/no-excludes" directory))
                           args)))
        (ert-info ((buffer-string)) (should (eq status 0)))))))

(ert-deftest zr-shadowfile-loading-does-not-load-built-in-shadowfile-or-enable-mode ()
  (with-temp-buffer
    (let ((status (call-process
                   invocation-name nil t nil "--batch" "-Q" "-L"
                   (file-name-directory (locate-library "zr-shadowfile"))
                   "--eval"
                   "(progn (require 'zr-shadowfile) (when (or (featurep 'shadowfile) (featurep 'tramp) zr-shadowfile-mode) (error \"Unexpected initialization\")))")))
      (ert-info ((buffer-string)) (should (eq status 0))))))

(ert-deftest zr-shadowfile-mode-is-idempotent-and-restores-hooks-and-key-binding ()
  (let ((key (lookup-key ctl-x-4-map "s")))
    (zr-shadowfile-test--with-state
      (puthash '("/source" . "/destination") t zr-shadowfile--pending)
      (zr-shadowfile-mode 1)
      (should (= (hash-table-count zr-shadowfile--pending) 1))
      (should (= (cl-count #'zr-shadowfile--after-save after-save-hook) 1))
      (should (= (cl-count #'zr-shadowfile--query-exit kill-emacs-query-functions) 1))
      (with-temp-buffer
        (let ((overriding-terminal-local-map nil))
          (should (eq (key-binding (kbd "C-x 4 s")) #'zr-shadowfile-copy-files))))
      (should (equal (lookup-key ctl-x-4-map "s") key))
      (zr-shadowfile-mode -1)
      (zr-shadowfile-mode -1)
      (should-not (memq #'zr-shadowfile--after-save after-save-hook))
      (should-not (memq #'zr-shadowfile--query-exit kill-emacs-query-functions))
      (should (= (hash-table-count zr-shadowfile--pending) 1)))
    (should (equal (lookup-key ctl-x-4-map "s") key))))

(ert-deftest zr-shadowfile-invalid-rules-roll-back-mode-activation ()
  (zr-shadowfile-test--with-state
    (zr-shadowfile-mode -1)
    (dolist (rules '("not a list" ((:source "~/org/"))
                     ((:source "~/org/" :destination "~/org/copies/"))
                     ((:source "~/org/" :destination "~/org/"))
                     ((:source "" :destination "~/copies/"))
                     ((:source "~/org/" :destination "~/copies/" :include "["))
                     ((:source "~/org/" :destination "~/copies/" :exclude 1))
                     ((:source "~/org/" :destination "~/copies/" :vc-only Git))
                     ((:source "~/org/" :destination "~/copies/" :vc-only 1))
                     ((:source "~/org/" :destination "~/copies/" :unknown t))
                     ((:source "~/org/" :source "~/org/" :destination "~/copies/"))
                     ((:source "~/org/" :destination))
                     ((:type file :source "~/notes.org" :destination "~/copies/notes.org"))
                     ((:source "~/notes.org" :destination "~/notes.org"))
                     ((:source "~/notes.org" :destination "~/copies/"))))
      (setq zr-shadowfile-rules rules)
      (should-error (zr-shadowfile-mode 1))
      (should-not zr-shadowfile-mode)
      (should-not zr-shadowfile--active)
      (should-not (memq #'zr-shadowfile--after-save after-save-hook)))))

(ert-deftest zr-shadowfile-source-paths-determine-mappings-before-they-exist ()
  (zr-shadowfile-test--with-state
    (let* ((source (expand-file-name "sources.d/"))
           (directory-target (expand-file-name "tree-copy"))
           (file (expand-file-name "notes"))
           (file-target (expand-file-name "file-copy"))
           (child (expand-file-name "nested/entry" source))
           (child-target (expand-file-name "nested/entry"
                                         (file-name-as-directory directory-target))))
      (zr-shadowfile-mode -1)
      (setq zr-shadowfile-rules
            (list (list :source source :destination directory-target)
                  (list :source file :destination file-target)
                  (list :source "/webdavs:offline@example.invalid:/dav/sources.d/"
                        :destination (expand-file-name "remote-tree-copy"))
                  (list :source "/webdavs:offline@example.invalid:/dav/notes"
                        :destination (expand-file-name "remote-file-copy"))))
      (cl-letf (((symbol-function 'zr-tramp-webdav--request)
                 (lambda (&rest _) (ert-fail "Rules must not connect to remote sources"))))
        (zr-shadowfile-mode 1)
        (zr-shadowfile-test--write file "File")
        (zr-shadowfile-test--write child "Directory child")
        (should (= (zr-shadowfile-queue-directory default-directory) 2))
        (should (gethash (cons file file-target) zr-shadowfile--pending))
        (should (gethash (cons child child-target) zr-shadowfile--pending))
        (should (= (zr-shadowfile-copy-files t) 2))
        (should (equal (zr-shadowfile-test--bytes file-target) "File"))
        (should (equal (zr-shadowfile-test--bytes child-target) "Directory child"))))))

(ert-deftest zr-shadowfile-invalid-state-is-not-evaluated ()
  (zr-shadowfile-test--with-state
    (zr-shadowfile-mode -1)
    (dolist (contents '("(setq zr-shadowfile-mode t)" "nil\nnil" "("))
      (write-region contents nil zr-shadowfile-pending-file nil 'silent)
      (should-error (zr-shadowfile-mode 1))
      (should-not zr-shadowfile-mode)
      (should-not zr-shadowfile--active)
      (should (= (hash-table-count zr-shadowfile--pending) 0)))))

(ert-deftest zr-shadowfile-state-file-lock-follows-the-mode-lifecycle ()
  (zr-shadowfile-test--with-state
    (zr-shadowfile-mode -1)
    (let ((create-lockfiles t))
      (zr-shadowfile-mode 1)
      (should (eq (file-locked-p zr-shadowfile-pending-file) t))
      (zr-shadowfile-mode -1)
      (should-not (file-locked-p zr-shadowfile-pending-file)))))

(ert-deftest zr-shadowfile-another-emacs-lock-is-not-released ()
  (zr-shadowfile-test--with-state
    (zr-shadowfile-mode -1)
    (cl-letf (((symbol-function 'file-locked-p) (lambda (_) "another user"))
              ((symbol-function 'unlock-file) (lambda (_) (ert-fail "Released foreign lock"))))
      (should-error (zr-shadowfile-mode 1) :type 'user-error))
    (should-not zr-shadowfile-mode)
    (should-not (memq #'zr-shadowfile--after-save after-save-hook))))

(ert-deftest zr-shadowfile-directory-queue-preserves-paths-excludes-git-and-deduplicates ()
  (zr-shadowfile-test--with-state
    (let ((source (expand-file-name "org/"))
          (destination "/webdavs:xxxx@app.koofr.net:/dav/Koofr/org/"))
      (setq zr-shadowfile-rules (list (zr-shadowfile-test--rule source destination)))
      (dolist (relative '("notes.org" "projects/中文 notes.org" ".git/config"
                          "projects/.git/objects/object" "worktree/.git" ".gitignore"))
        (zr-shadowfile-test--write (expand-file-name relative source) "Contents"))
      (cl-letf (((symbol-function 'zr-tramp-webdav--request)
                 (lambda (&rest _) (ert-fail "Queuing must not connect to WebDAV"))))
        (should (= (zr-shadowfile-queue-directory source) 3))
        (should (= (zr-shadowfile-queue-directory source) 0))
        (should (= (zr-shadowfile-queue-directory (expand-file-name ".git/" source)) 0)))
      (dolist (relative '("notes.org" "projects/中文 notes.org" ".gitignore"))
        (let ((pair (cons (expand-file-name relative source) (concat destination relative))))
          (should (gethash pair zr-shadowfile--pending))
          (should (member pair (zr-shadowfile-test--state))))))))

(ert-deftest zr-shadowfile-vc-only-directory-rules-filter-registered-files ()
  (skip-unless (executable-find "git"))
  (zr-shadowfile-test--with-state
    (let* ((vc-handled-backends '(Git))
           (source (expand-file-name "sources/"))
           (repository (expand-file-name "project/" source))
           (destination (expand-file-name "copies/")))
      (make-directory repository t)
      (zr-shadowfile-test--git repository "init" "--quiet")
      (zr-shadowfile-test--write (expand-file-name ".gitignore" repository) "ignored.org\n")
      (dolist (relative '("tracked.org" "nested/中文 notes.org" "private/hidden.org" "README.txt"))
        (zr-shadowfile-test--write (expand-file-name relative repository) "Committed"))
      (zr-shadowfile-test--git repository "add" "--" ".gitignore" "tracked.org"
                               "nested/中文 notes.org" "private/hidden.org" "README.txt")
      (zr-shadowfile-test--git repository "commit" "--quiet" "-m" "Initial files")
      (zr-shadowfile-test--write (expand-file-name "tracked.org" repository) "Modified")
      (zr-shadowfile-test--write (expand-file-name "added.org" repository) "Added")
      (zr-shadowfile-test--git repository "add" "--" "added.org")
      (dolist (relative '("untracked.org" "ignored.org"))
        (zr-shadowfile-test--write (expand-file-name relative repository) "Not tracked"))
      (zr-shadowfile-test--write (expand-file-name "loose.org" source) "No repository")
      (setq zr-shadowfile-rules
            (list (list :source source :destination destination :vc-only t)))
      (should (= (zr-shadowfile-queue-directory source) 6))
      (dolist (relative '(".gitignore" "tracked.org" "nested/中文 notes.org"
                          "private/hidden.org" "README.txt" "added.org"))
        (should (gethash (cons (expand-file-name relative repository)
                               (expand-file-name (concat "project/" relative) destination))
                         zr-shadowfile--pending)))
      (should (= (zr-shadowfile-cancel t) 6))
      (setf (plist-get (car zr-shadowfile-rules) :include) "\\.org\\'"
            (plist-get (car zr-shadowfile-rules) :exclude) "\\`project/private\\'")
      (should (= (zr-shadowfile-queue-directory source) 3))
      (should-not (gethash (cons (expand-file-name "private/hidden.org" repository)
                                 (expand-file-name "project/private/hidden.org" destination))
                           zr-shadowfile--pending)))))

(ert-deftest zr-shadowfile-vc-filter-is-optional-for-each-rule ()
  (skip-unless (executable-find "git"))
  (zr-shadowfile-test--with-state
    (let* ((vc-handled-backends '(Git))
           (source (expand-file-name "repository/"))
           (tracked (expand-file-name "tracked.org" source))
           (untracked (expand-file-name "untracked.org" source))
           (filtered (expand-file-name "filtered/"))
           (ordinary (expand-file-name "ordinary/"))
           (explicit-nil (expand-file-name "explicit-nil/")))
      (zr-shadowfile-test--write tracked "Tracked")
      (zr-shadowfile-test--write untracked "Untracked")
      (zr-shadowfile-test--git source "init" "--quiet")
      (zr-shadowfile-test--git source "add" "--" "tracked.org")
      (setq zr-shadowfile-rules
            (list (append (zr-shadowfile-test--rule source filtered) '(:vc-only t))
                  (zr-shadowfile-test--rule source ordinary)
                  (append (zr-shadowfile-test--rule source explicit-nil) '(:vc-only nil))))
      (should (= (zr-shadowfile-queue-directory source) 5))
      (dolist (destination (list filtered ordinary explicit-nil))
        (should (gethash (cons tracked (expand-file-name "tracked.org" destination))
                         zr-shadowfile--pending))
        (should (eq (gethash (cons untracked (expand-file-name "untracked.org" destination))
                             zr-shadowfile--pending)
                    (not (equal destination filtered)))))
      (should (= (zr-shadowfile-cancel t) 5))
      (setq zr-shadowfile-rules (cdr zr-shadowfile-rules))
      (cl-letf (((symbol-function 'vc-registered)
                 (lambda (_) (ert-fail "Disabled VC filters must not query VC"))))
        (should (= (zr-shadowfile-queue-directory source) 4))))))

(ert-deftest zr-shadowfile-vc-only-file-queues-and-saves-recheck-registration ()
  (skip-unless (executable-find "git"))
  (zr-shadowfile-test--with-state
    (let* ((vc-handled-backends '(Git))
           (source (expand-file-name "repository/"))
           (file (expand-file-name "notes.org" source))
           (directory-target (expand-file-name "copies/"))
           (file-target (expand-file-name "renamed/backup.org"))
           (one-off (expand-file-name "one-off/notes.org")))
      (zr-shadowfile-test--write file "Saved")
      (zr-shadowfile-test--git source "init" "--quiet")
      (setq zr-shadowfile-rules
            (list (list :source source :destination directory-target :vc-only t)
                  (list :source file :destination file-target :vc-only t)))
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max)) (insert "\nUntracked save") (save-buffer))
      (should (= (hash-table-count zr-shadowfile--pending) 0))
      (should (= (zr-shadowfile-queue-file file) 0))
      (should-not (vc-backend file))
      (should (= (zr-shadowfile-queue-file file one-off) 1))
      (should (= (zr-shadowfile-copy-files t) 1))
      (zr-shadowfile-test--git source "add" "--" "notes.org")
      (should (= (zr-shadowfile-queue-file file) 2))
      (should (= (zr-shadowfile-copy-files t) 2))
      (zr-shadowfile-test--git source "rm" "--cached" "--quiet" "--" "notes.org")
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max)) (insert "\nRemoved from index") (save-buffer))
      (should (= (hash-table-count zr-shadowfile--pending) 0))
      (zr-shadowfile-test--git source "add" "--" "notes.org")
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max)) (insert "\nRegistered save") (save-buffer))
      (should (gethash (cons file file-target) zr-shadowfile--pending))
      (should (gethash (cons file (expand-file-name "notes.org" directory-target))
                       zr-shadowfile--pending))
      (should (= (length (zr-shadowfile-test--state)) 2))
      (should (= (zr-shadowfile-copy-files t) 2))
      (should (equal (zr-shadowfile-test--bytes file-target)
                     (zr-shadowfile-test--bytes file))))))

(ert-deftest zr-shadowfile-excluding-a-directory-also-excludes-later-saves ()
  (zr-shadowfile-test--with-state
    (let ((source (expand-file-name "org/"))
          (destination (expand-file-name "copies/")))
      (setq zr-shadowfile-rules
            (list (list :source source :destination destination :exclude "\\`private\\'")))
      (dolist (relative '("public.org" "private/nested/notes.org"))
        (zr-shadowfile-test--write (expand-file-name relative source) "Saved"))
      (should (= (zr-shadowfile-queue-directory source) 1))
      (with-current-buffer (find-file-noselect (expand-file-name "private/nested/notes.org" source))
        (goto-char (point-max)) (insert "\nChanged") (save-buffer))
      (should (= (hash-table-count zr-shadowfile--pending) 1))
      (should (= (length (zr-shadowfile-test--state)) 1)))))

(ert-deftest zr-shadowfile-include-matches-files-without-pruning-parent-directories ()
