;;; zr-android-test.el --- Tests for zr-android -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'image)
(require 'tool-bar)
(require 'zr-android)

(ert-deftest zr-android-test-toolbar-has-displayable-images ()
  (let ((secondary-tool-bar-map (make-sparse-keymap))
        (input-decode-map (make-sparse-keymap))
        (modifier-bar-mode t)
        (modifier-bar-mode-hook nil)
        (zr-android-toolbar-mode nil)
        (zr-android--saved-toolbar nil)
        (tool-bar-keymap-cache (make-hash-table :test #'equal))
        images)
    (unwind-protect
        ;; Exercise Emacs's image expressions even in a non-graphical build.
        (cl-letf (((symbol-function 'zr-android--gui) #'ignore)
                  ((symbol-function 'display-images-p) (lambda (&rest _) t))
                  ((symbol-function 'image-type) (lambda (&rest _) 'pbm))
                  ((symbol-function 'image-type-available-p)
                   (lambda (type) (eq type 'pbm)))
                  ((symbol-function 'image-mask-p) (lambda (&rest _) t)))
          (zr-android-toolbar-mode 1)
          (let ((map (tool-bar-make-keymap-1 secondary-tool-bar-map)))
            (dolist (key '(zr-quit zr-cx zr-cc zr-help zr-cu
                          zr-menu-bar zr-context-menu zr-repeat zr-keyboard zr-read-only))
              (ert-info ((symbol-name key))
                (let* ((binding (cdr (assq key (cdr map))))
                       (image (plist-get (nthcdr 3 binding) :image))
                       (file (plist-get (cdr image) :file)))
                  (should (eq (car-safe image) 'image))
                  (should (eq (plist-get (cdr image) :type) 'pbm))
                  (should (stringp file))
                  (should (file-exists-p file))
                  (push file images)))))
          (should (= (length (delete-dups images)) 10)))
      (zr-android-toolbar-mode -1))))

(ert-deftest zr-android-test-toolbar-survives-modifier-bar-rebuilds ()
  (let* ((secondary-tool-bar-map nil)
         (input-decode-map (make-sparse-keymap))
         (modifier-bar-mode nil)
         (modifier-bar-mode-hook nil)
         (zr-android-toolbar-mode nil)
         (zr-android--saved-toolbar nil)
         (meta-prefix-char ?\e)
         (tool-bar-keymap-cache (make-hash-table :test #'equal)))
    (unwind-protect
        (cl-letf (((symbol-function 'zr-android--gui) #'ignore)
                  ((symbol-function 'display-images-p) (lambda (&rest _) nil)))
          (zr-android-toolbar-mode 1)
          (should-not secondary-tool-bar-map)
          (modifier-bar-mode 1)
          (let ((cache-key (tool-bar--secondary-cache-key)))
            (puthash cache-key (tool-bar-make-keymap-1 secondary-tool-bar-map)
                     tool-bar-keymap-cache)
            (zr-android-toolbar-mode 1)
            (should-not (gethash cache-key tool-bar-keymap-cache)))
          (modifier-bar-mode -1)
          (should-not secondary-tool-bar-map)
          (modifier-bar-mode 1)
          (should (= (length (cdr secondary-tool-bar-map)) 14))
          (should (equal (mapcar #'car (cdr secondary-tool-bar-map))
                         '(control shift meta hyper
                           zr-quit zr-cx zr-cc zr-help zr-cu
                           zr-menu-bar zr-context-menu zr-repeat zr-keyboard zr-read-only)))
          (dolist (entry '((zr-quit "C-g") (meta "ESC") (zr-cx "C-x")
                           (zr-cc "C-c") (zr-help "C-h") (zr-cu "C-u")))
            (let (keyboard-calls)
              (cl-letf (((symbol-function 'frame-toggle-on-screen-keyboard)
                         (lambda (&rest args) (push args keyboard-calls))))
                (should (equal (funcall (lookup-key input-decode-map
                                                   (vector 'tool-bar (car entry)))
                                        nil)
                               (vconcat (kbd (cadr entry)))))
                (should (equal keyboard-calls
                               (unless (eq (car entry) 'zr-quit) '((nil nil))))))))
          (should (eq (lookup-key secondary-tool-bar-map [control])
                      'event-apply-control-modifier))
          (should-not (lookup-key secondary-tool-bar-map [alt]))
          (should-not (lookup-key secondary-tool-bar-map [super]))
          (should (eq (lookup-key secondary-tool-bar-map [zr-menu-bar])
                      'zr-android--popup-menu-bar))
          (should (eq (lookup-key secondary-tool-bar-map [zr-context-menu])
                      'zr-android--context-menu-open))
          (should (eq (lookup-key secondary-tool-bar-map [zr-keyboard])
                      'zr-android-toggle-keyboard))
          (should (eq (lookup-key secondary-tool-bar-map [zr-repeat]) 'repeat))
          (should (eq (lookup-key secondary-tool-bar-map [zr-read-only])
                      'read-only-mode))
          (let ((cache-key (tool-bar--secondary-cache-key)))
            (puthash cache-key (tool-bar-make-keymap-1 secondary-tool-bar-map)
                     tool-bar-keymap-cache)
            (zr-android-toolbar-mode -1)
            (should-not (gethash cache-key tool-bar-keymap-cache)))
          (should modifier-bar-mode)
          (should (equal (mapcar #'car (cdr secondary-tool-bar-map))
                         '(control shift meta alt super hyper)))
          (dolist (modifier '(control shift meta alt super hyper))
            (should (eq (lookup-key input-decode-map (vector 'tool-bar modifier))
                        (intern (format "tool-bar-event-apply-%s-modifier" modifier)))))
          (dolist (key '(zr-quit zr-cx zr-cc zr-help zr-cu))
            (should-not (lookup-key input-decode-map (vector 'tool-bar key))))
          (zr-android-toolbar-mode 1)
          (should (= (length (cdr secondary-tool-bar-map)) 14))
          (zr-android-toolbar-mode -1)
          (should (= (length (cdr secondary-tool-bar-map)) 6)))
      (zr-android-toolbar-mode -1))))

(ert-deftest zr-android-test-toolbar-context-menu-at-point ()
  (let* ((secondary-tool-bar-map (make-sparse-keymap))
         (input-decode-map (make-sparse-keymap))
         (modifier-bar-mode t)
         (tool-bar-keymap-cache (make-hash-table :test #'equal))
         (toolbar-event (list 'tool-bar (list (selected-frame) '(tool-bar))
                              'zr-context-menu))
         (last-input-event toolbar-event)
         (context-menu-functions nil)
         (context-menu-filter-function nil)
         menu-position popup-position popup-map)
    (zr-android--toolbar)
    (save-window-excursion
      (with-temp-buffer
        (insert "abc")
        (goto-char 2)
        (switch-to-buffer (current-buffer))
        (put-text-property
         2 3 'context-menu-function
         (lambda (menu click)
           (setq menu-position (event-start click))
           (define-key menu [test-action] '(menu-item "Test action" ignore))
           menu))
        (cl-letf (((symbol-function 'popup-menu)
                   (lambda (menu position &rest _)
                     (setq popup-map menu popup-position position))))
          (call-interactively (lookup-key secondary-tool-bar-map [zr-context-menu])))
        (should (eq (posn-window menu-position) (selected-window)))
        (should (= (posn-point menu-position) 2))
        (should (= popup-position 2))
        (should (eq (lookup-key popup-map [test-action]) #'ignore))
        (should (eq last-input-event toolbar-event))
        (should (= (point) 2))))))

(ert-deftest zr-android-test-toolbar-meta-uses-current-prefix ()
  (let ((secondary-tool-bar-map nil)
        (input-decode-map (make-sparse-keymap))
        (modifier-bar-mode nil)
        (modifier-bar-mode-hook nil)
        (zr-android-toolbar-mode nil)
        (zr-android--saved-toolbar nil)
        (meta-prefix-char ?\e)
        (tool-bar-keymap-cache (make-hash-table :test #'equal))
        keyboard-calls)
    (unwind-protect
        (cl-letf (((symbol-function 'zr-android--gui) #'ignore)
                  ((symbol-function 'frame-toggle-on-screen-keyboard)
                   (lambda (&rest args) (push args keyboard-calls))))
          (modifier-bar-mode 1)
          (zr-android-toolbar-mode 1)
          (let ((translation (lookup-key input-decode-map [tool-bar meta])))
            (should (equal (funcall translation nil) [?\e]))
            (setq meta-prefix-char ?\C-z)
            (should (equal (funcall translation nil) [?\C-z]))
            (should (equal keyboard-calls '((nil nil) (nil nil))))))
      (zr-android-toolbar-mode -1))))

(ert-deftest zr-android-test-toolbar-keeps-modifier-bar-disabled ()
  (let ((secondary-tool-bar-map nil)
        (input-decode-map (make-sparse-keymap))
        (modifier-bar-mode nil)
        (modifier-bar-mode-hook nil)
        (zr-android-toolbar-mode nil)
        (zr-android--saved-toolbar nil)
        (tool-bar-keymap-cache (make-hash-table :test #'equal)))
    (unwind-protect
        (cl-letf (((symbol-function 'zr-android--gui) #'ignore))
          (modifier-bar-mode 1)
          (zr-android-toolbar-mode 1)
          (modifier-bar-mode -1)
          (zr-android-toolbar-mode -1)
          (should-not modifier-bar-mode)
          (should-not secondary-tool-bar-map)
          (should (eq (lookup-key input-decode-map [tool-bar control])
                      #'tool-bar-event-apply-control-modifier))
          (should (eq (lookup-key input-decode-map [tool-bar meta])
                      #'tool-bar-event-apply-meta-modifier))
          (dolist (key '(zr-quit zr-cx zr-cc zr-help zr-cu))
            (should-not (lookup-key input-decode-map (vector 'tool-bar key)))))
      (zr-android-toolbar-mode -1))))

(ert-deftest zr-android-test-toolbar-preserves-decoder-changes-on-rebuild ()
  (let ((secondary-tool-bar-map nil)
        (input-decode-map (make-sparse-keymap))
        (modifier-bar-mode nil)
        (modifier-bar-mode-hook nil)
        (zr-android-toolbar-mode nil)
        (zr-android--saved-toolbar nil)
        (tool-bar-keymap-cache (make-hash-table :test #'equal)))
    (define-key input-decode-map [tool-bar zr-cx] #'ignore)
    (unwind-protect
        (cl-letf (((symbol-function 'zr-android--gui) #'ignore))
          (zr-android-toolbar-mode 1)
          (define-key input-decode-map [tool-bar other] #'ignore)
          (modifier-bar-mode 1)
          (modifier-bar-mode 1)
          (zr-android-toolbar-mode -1)
          (should modifier-bar-mode)
          (should (= (length (cdr secondary-tool-bar-map)) 6))
          (should (eq (lookup-key input-decode-map [tool-bar control])
                      #'tool-bar-event-apply-control-modifier))
          (should (eq (lookup-key input-decode-map [tool-bar zr-cx]) #'ignore))
          (should (eq (lookup-key input-decode-map [tool-bar other]) #'ignore)))
      (zr-android-toolbar-mode -1))))

(ert-deftest zr-android-test-toolbar-restores-maps ()
  (let* ((secondary-tool-bar-map (make-sparse-keymap))
         (input-decode-map (make-sparse-keymap))
         (original-toolbar secondary-tool-bar-map)
         (original-input input-decode-map)
         (modifier-bar-mode t)
         (modifier-bar-mode-hook nil)
         (zr-android-toolbar-mode nil)
         (zr-android--saved-toolbar nil)
         (tool-bar-keymap-cache (make-hash-table :test #'equal)))
    (unwind-protect
        (cl-letf (((symbol-function 'zr-android--gui) #'ignore))
          (zr-android-toolbar-mode 1)
          (zr-android-toolbar-mode 1)
          (should (lookup-key secondary-tool-bar-map [zr-keyboard]))
          (should (= (cl-count #'zr-android--modifier-bar-changed modifier-bar-mode-hook) 1))
          (zr-android-toolbar-mode -1)
          (should (eq secondary-tool-bar-map original-toolbar))
          (should (eq input-decode-map original-input)))
      (zr-android-toolbar-mode -1))))

(provide 'zr-android-test)
