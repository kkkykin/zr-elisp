;;; zr-org-link-test.el --- Tests for zr-org-link -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'zr-org-link)
(require 'zr-test-helpers)
(require 'zr-dictionary-test-helpers)

(ert-deftest zr-org-link-test-ssh-opens-once ()
  (dolist (text '("https://example.com/path?q=1&x=2\n"
                  "[[http://example.com/path][Example]]\n"))
    (dolist (environment '(("SSH_CONNECTION" frame)
                           ("SSH_CLIENT" frame)
                           ("SSH_CONNECTION" process)
                           ("SSH_CLIENT" process)))
      (zr-test-with-org-buffer text
        (search-forward "example")
        (let ((org-open-at-point-functions '(zr-org-link-open-at-point))
              sent)
          (cl-letf (((symbol-function 'getenv)
                     (lambda (variable &optional frame)
                       (when (and (equal variable (car environment))
                                  (eq (if frame 'frame 'process)
                                      (cadr environment)))
                         "ssh-session")))
                    ((symbol-function 'zr-wezterm-send-json)
                     (lambda (payload)
                       (push payload sent)
                       nil))
                    ((symbol-function 'browse-url)
                     (lambda (&rest _) (ert-fail "Unexpected browser fallback"))))
            (let ((url (org-element-property :raw-link (org-element-context))))
              (should (zr-org-link-open-at-point))
              (should (equal sent `(((type . "open_uri") (uri . ,url))))))
            (setq sent nil)
            (org-open-at-point)
            (should (= (length sent) 1))))))))

(ert-deftest zr-org-link-test-ignores-local-and-non-http-links ()
  (dolist (case '((nil "https://example.com/\n")
                  ("ssh-session" "[[file:/tmp/example.txt]]\n")
                  ("ssh-session" "Plain text\n")))
    (zr-test-with-org-buffer (cadr case)
      (cl-letf (((symbol-function 'getenv) (lambda (&rest _) (car case)))
                ((symbol-function 'zr-wezterm-send-json)
                 (lambda (&rest _) (ert-fail "Unexpected WezTerm request"))))
        (should-not (zr-org-link-open-at-point))))))

(ert-deftest zr-org-link-test-link-escapes-html ()
  (let ((html (zr-org-link--export "a&b" "<label>" 'html nil)))
    (should (string-match-p "&lt;label&gt;" html))
    (should (string-match-p "a%26b" html))
    (should-not (string-match-p ">\(<label>\)" html))))

(ert-deftest zr-org-link-test-link-handler-restoration ()
  (let ((org-link-parameters (copy-tree org-link-parameters)))
    (org-link-set-parameters "dict" :follow #'ignore)
    (zr-org-link-mode 1)
    (zr-org-link-mode 1)
    (zr-org-link-mode -1)
    (should (eq (org-link-get-parameter "dict" :follow) #'ignore))))

(ert-deftest zr-org-link-test-dict-follow-parameters-and-encoding ()
  (let ((org-link-parameters (copy-tree org-link-parameters))
        (zr-org-link-mode nil)
        (zr-org-link--saved nil)
        (word "猫 a?b&c+100%")
        (stages '((:server t :port t :dictionary ("dict1" dict2))
                  (:server t :port t :dictionary dict3) similar))
        calls)
    (unwind-protect
        (progn
          (zr-org-link-mode 1)
          (zr-test-with-org-buffer (zr-org-link-dict-link word stages "prefix")
            (cl-letf (((symbol-function 'zr-dictionary-search)
                       (lambda (&rest args) (push args calls))))
              (org-open-at-point)
              (should (equal calls (list (list word '(((:dictionary "dict1") (:dictionary "dict2"))
                                                    ((:dictionary "dict3")) similar) "prefix")))))))
      (zr-org-link-mode -1))))

(ert-deftest zr-org-link-test-dict-defaults-and-nil-override ()
  (let ((zr-dictionary-dictionaries '((:server t :port t :dictionary (dict1 dict2 similar))))
        (zr-dictionary-strategy "suffix"))
    (should (equal (zr-org-link--dict-query "word")
                   '("word" ((:server t :port t :dictionary (dict1 dict2 similar))) "suffix")))
    (should (equal (zr-org-link--dict-query "word?strategy=prefix")
                   '("word" ((:server t :port t :dictionary (dict1 dict2 similar))) "prefix")))
    (should (equal (zr-org-link--dict-query "word?dictionaries=nil")
                   '("word" nil "suffix")))
    (should-error (zr-org-link--dict-query "word?unknown=value") :type 'user-error)
    (should-error (zr-org-link--dict-query "word?dictionaries=(dict1)%20junk") :type 'user-error)))

(ert-deftest zr-org-link-test-store-dictionary-query ()
  (zr-dictionary-test-with-server
   (save-window-excursion
     (unwind-protect
         (progn
           (zr-dictionary-test-search "猫" '((:server t :port t :dictionary (dict1 similar))) "prefix")
           (let* ((org-store-link-plist nil)
                  (link (zr-org-link--store)))
             (should (equal (plist-get org-store-link-plist :description) "猫"))
             (should (equal (zr-org-link--dict-query (substring link 5))
                            '("猫" (((:dictionary ("dict1" similar)))) "prefix")))))
       (when-let* ((buffer (get-buffer "*zr-dictionary*")))
         (kill-buffer buffer))))))

(ert-deftest zr-org-link-test-export-dict-query-uses-only-word ()
  (let ((html (zr-org-link--export "a%26b?dictionaries=(dict1)&strategy=prefix" nil 'html nil)))
    (should (string-match-p "a%26b" html))
    (should (string-match-p ">a&amp;b</a>" html))
    (should-not (string-match-p "dictionaries\\|strategy" html))))

(ert-deftest zr-org-link-test-generated-links-freeze-server-defaults ()
  (let* ((zr-org-link-dict-include-server t)
         (dictionary-server "initial.example")
         (dictionary-port 1234)
         (stages '(((:server t :port t :dictionary local)
                    (:server "remote.example" :port t :dictionary (a b))) similar))
         (resolved (zr-dictionary-resolve-dictionaries stages))
         (path (zr-org-link--dict-path "猫" stages "prefix")))
    (setq dictionary-server "changed.example" dictionary-port 4321)
    (should (equal (zr-org-link--dict-query (substring path 5))
                   (list "猫" resolved "prefix")))))

(ert-deftest zr-org-link-test-generated-links-omit-servers-by-default ()
  (let* ((zr-org-link-dict-include-server nil)
         (stages '(((:server "first.example" :port 1234 :dictionary (a b))
                    (:server "second.example" :port 2345 :dictionary c)) similar))
         (path (zr-org-link--dict-path "猫" stages "prefix")))
    (should (equal (zr-org-link--dict-query (substring path 5))
                   '("猫" (((:dictionary "a") (:dictionary "b") (:dictionary "c")) similar) "prefix")))
    (should-not (string-match-p "first.example\\|second.example\\|1234\\|2345" path))))

(provide 'zr-org-link-test)
